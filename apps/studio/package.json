{
  "name": "@repo/studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "pnpm typegen",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "predev": "pnpm typegen",
    "dev": "sanity dev",
    "format": "prettier . --check --log-level silent --ignore-path ../../.gitignore",
    "format:fix": "prettier . --write --log-level silent --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "script:lint": "bash -e ../../scripts/lint.sh --filter=@repo/studio",
    "start": "sanity start",
    "typecheck": "tsc --noEmit",
    "typegen": "sanity schema extract  --workspace custom-structure-builder --enforce-required-fields && sanity typegen generate"
  },
  "dependencies": {
    "@sanity/assist": "^5.0.4",
    "@sanity/client": "^7.21.0",
    "@sanity/icons": "^3.7.4",
    "@sanity/schema": "^5.21.0",
    "@sanity/vision": "^5.21.0",
    "pluralize": "^8.0.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sanity": "^5.21.0",
    "sanity-plugin-media": "^4.1.1",
    "styled-components": "^6.4.1"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/pluralize": "^0.0.33",
    "@types/react": "^19.2.14",
    "babel-plugin-react-compiler": "^1.0.0",
    "type-fest": "^5.6.0",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "engines": {
    "node": ">=24"
  }
}
